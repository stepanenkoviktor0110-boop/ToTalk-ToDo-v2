# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# GigaChat OAuth2 credentials (base64-encoded client credentials for Basic auth)
GIGACHAT_AUTH_KEY=

# GigaChat model name (default: GigaChat-2)
GIGACHAT_MODEL=GigaChat-2

# faster-whisper transcription service URL (default: http://localhost:8765)
WHISPER_URL=http://localhost:8765

# SQLite database file path (default: data/bot.db)
DB_PATH=data/bot.db
