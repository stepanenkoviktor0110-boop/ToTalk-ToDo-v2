# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenRouter API key
OPENROUTER_API_KEY=

# LLM model (default: qwen/qwen-2.5-72b-instruct)
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# faster-whisper transcription service URL
WHISPER_URL=http://localhost:8765

# SQLite database file path
DB_PATH=data/bot.db

# Owner Telegram ID
OWNER_ID=
